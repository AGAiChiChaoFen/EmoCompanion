HF_TOKEN=Hf_token_here
MODEL_PATH_QWEN_QWEN2_AUDIO_7B_INSTRUCT=path/to/pretrained_models/Qwen/Qwen2-Audio-7B-Instruct
MODEL_PATH_AJUPYTER_EMOLLM_QWEN2_7B_INSTRUCT_LORA=path/to/pretrained_models/aJupyter/EmoLLM_Qwen2-7B-Instruct_lora
MODEL_PATH_QWEN_QWEN3_TTS_12HZ_1_7B_BASE=path/to/pretrained_models/Qwen/Qwen3-TTS-12Hz-1.7B-Base
MODEL_PATH_QWEN_QWEN3_TTS_12HZ_1_7B_CUSTOMVOICE=path/to/pretrained_models/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# DeepFace 权重目录（Windows 本机用正斜杠绝对路径，如 D:/path/deepface_weights）
DEEPFACE_HOME=/path/to/deepface_weights
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=9100
FASTAPI_RELOAD=true

# ---------- PersonaVLM 云端后端（阿里云百炼，可选） ----------
# 配置后 /persona/chat 与 /emollm(provider=persona/auto) 走长期记忆/人格演化后端；
# 未配置时 persona 路由返回 503，/emollm 的 auto 直接回退本地 EmoLLM。
DASHSCOPE_API_KEY=
# OpenAI 兼容端点 URL（从百炼控制台导出的 CSV 的 openAiCompatible 行获取）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_DEFAULT_MODEL=qwen3.7-plus
# PersonaVLM 场景下必须为 false（推理链由框架自行调度）
DASHSCOPE_ENABLE_THINKING=false