# 从 Audio-Emotion-Analysis 目录启动，模型目录相对于该目录。
# 部署前用本文件的路径设置更新 .env；原 .env 仍保留服务器备份配置。
MODEL_PATH_QWEN_QWEN2_AUDIO_7B_INSTRUCT=audio_emotion/pretrained_models/Qwen/Qwen2-Audio-7B-Instruct
MODEL_PATH_AJUPYTER_EMOLLM_QWEN2_7B_INSTRUCT_LORA=audio_emotion/pretrained_models/aJupyter/EmoLLM_Qwen2-7B-Instruct_lora
MODEL_PATH_QWEN_QWEN3_TTS_12HZ_1_7B_CUSTOMVOICE=audio_emotion/pretrained_models/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
DEEPFACE_HOME=deepface_weights
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=9100
FASTAPI_RELOAD=false

# 可选云端 PersonaVLM；未配置密钥时该模块的对话路由返回 503。
# 当前主工程 PersonaVLM 对话服务仍独立运行，不必切换到此路由。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_DEFAULT_MODEL=qwen3.7-plus
DASHSCOPE_ENABLE_THINKING=false
