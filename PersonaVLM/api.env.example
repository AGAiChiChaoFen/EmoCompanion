# Flask API 监听配置
PERSONA_API_HOST=0.0.0.0
PERSONA_API_PORT=9001

# PersonaVLM 数据和模型目录；相对路径请改成服务器实际的绝对路径
PERSONA_API_OUTPUT_ROOT=/data/EmoCompanion/PersonaVLM/output
PERSONA_API_MODEL_PATH=/data/EmoCompanion/PersonaVLM/checkpoints/rl

# 允许访问 API 的前端地址，多个地址用英文逗号分隔
PERSONA_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9010,http://127.0.0.1:9010,http://119.45.194.33:9010

# DEBUG、INFO、WARNING 或 ERROR
PERSONA_API_LOG_LEVEL=INFO

# 最大请求体，默认1 MiB
PERSONA_API_MAX_BODY_BYTES=1048576

# 推理行为
PERSONA_API_REASONING_MODE=true
PERSONA_API_FORCE_RETRIEVE=false
