# Copy this file to config.env on the server and fill in local credentials.
PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
TALKINGHEAD_DIR="$PROJECT_ROOT/ditto-talkinghead"
LIVETALKING_DIR="$PROJECT_ROOT/LiveTalking"
PERSONAVLM_DIR="$PROJECT_ROOT/PersonaVLM"

CONDA_SH="/path/to/miniconda3/etc/profile.d/conda.sh"
CONDA_ENV_NAME="ditto-livetalking"
CUDA_VISIBLE_DEVICES="0"
TENSORRT_LIB_DIR="/path/to/TensorRT/lib"

DITTO_DATA_ROOT="$PROJECT_ROOT/checkpoints/ditto_pytorch"
DITTO_CFG_PKL="$PROJECT_ROOT/checkpoints/ditto_cfg/v0.4_hubert_cfg_pytorch.pkl"
DITTO_SOURCE_PATH="$PROJECT_ROOT/LiveTalking/data/avatars/default_avatar.png"
LIVE_TALKING_MODEL="ditto"
LIVE_TALKING_TRANSPORT="webrtc"
DITTO_CHUNKSIZE="3 5 2"
LISTEN_PORT="9000"

TTS_MODE="qwen3tts"
DASHSCOPE_API_KEY=""
QWEN_API_KEY=""
QWEN_MODEL="qwen3-tts-flash"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_LANGUAGE_TYPE="Chinese"

ASR_PROVIDER="qwenaudio"
QWENAUDIO_API_URL="http://127.0.0.1:9100/asr"
ASR_BACKEND="custom"
ASR_CUSTOM_HANDLER="custom_api_handlers:asr_http_handler"
FUNASR_API_KEY=""

PERSONA_API_ENABLE="1"
PERSONA_API_HOST="0.0.0.0"
PERSONA_API_HEALTH_HOST="127.0.0.1"
PERSONA_API_PORT="9001"
PERSONA_API_OUTPUT_ROOT="$PERSONAVLM_DIR/output"
PERSONA_API_MODEL_PATH="$PERSONAVLM_DIR/checkpoints/rl"
PERSONA_API_DEFAULT_USER=""
PERSONA_API_PRELOAD_MODEL="1"
PERSONA_API_STARTUP_TIMEOUT_S="600"
PERSONAVLM_EMOLLM_API_URL="http://127.0.0.1:${PERSONA_API_PORT}/emollm"
LLM_PROVIDER="personavlm"

DEEPFACE_ENABLE="1"
DEEPFACE_API_URL="http://127.0.0.1:9020"
LIGHTRAG_ENABLE="1"
LIGHTRAG_BASE_URL="http://127.0.0.1:9622"
LIGHTRAG_USERNAME=""
LIGHTRAG_PASSWORD=""

TURN_HOST=""
TURN_PORT="3478"
TURN_TLS_PORT="5349"
TURN_ENABLE_UDP="1"
TURN_ENABLE_TCP="1"
TURN_ENABLE_TLS="0"
TURN_USERNAME=""
TURN_PASSWORD=""
ICE_TRANSPORT_POLICY="all"
PREFER_H264="1"

VITE_API_BASE_URL="http://127.0.0.1:9000"
VITE_PERSONA_API_BASE_URL="http://127.0.0.1:9001"
